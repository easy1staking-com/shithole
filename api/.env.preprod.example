# Shithole BE — preprod environment template.
#
# Copy to api/.env.preprod and populate. Source it before `./gradlew bootRun`:
#
#   set -a; source api/.env.preprod; set +a; cd api && ./gradlew bootRun
#
# .gitignore excludes any file matching `.env.preprod` / `.env.mainnet` — only
# the .example templates are tracked.

# --------------------------------------------------------------------
# Database
# --------------------------------------------------------------------
# Local Postgres on host :5433 (compose) or :5432 (host-level homebrew).
DB_URL=jdbc:postgresql://localhost:5433/shithole
DB_USERNAME=shithole
DB_PASSWORD=shithole

# --------------------------------------------------------------------
# Network selectors
# --------------------------------------------------------------------
# `APP_NETWORK` drives address derivation (preprod address prefix `addr_test1`)
# and the BlockfrostConfig default URL fallback. `NETWORK` is the legacy
# indexer hint (devnet | preprod | preview | mainnet).
APP_NETWORK=preprod
NETWORK=preprod

# Cardano protocol magic. Preprod = 1, Preview = 2, Mainnet = 764824073,
# Yaci DevKit = 42.
PROTOCOL_MAGIC=1

# --------------------------------------------------------------------
# Yaci Store chain-sync
# --------------------------------------------------------------------
# Cardano node host:port the indexer connects to via Ouroboros. For preprod
# you can:
#   (a) point at a public preprod relay,
#   (b) run a local cardano-node against preprod,
#   (c) use yaci-devkit's preprod proxy.
# Default below assumes a local node on the standard relay port.
REMOTE_NODE_URL=localhost
REMOTE_NODE_PORT=3001

# Operator-set starting slot. Backfills only blocks at/after this slot.
# Pick a slot ~24h before your first config deploy so the indexer is bounded
# but still captures the deploy. Preprod tip slot: check
# https://preprod.cexplorer.io/.
SHITHOLE_INDEXER_START_SLOT=

# Toggle the indexer on/off. Default true; flip to false to bring the BE up
# without subscribing to chain events (useful for offline FE-only dev).
SHITHOLE_INDEXER_ENABLED=true

# Toggle Yaci sync at startup. Default true; flip to false if you only need
# the REST endpoints (e.g. when no node is reachable).
YACI_SYNC_AUTO_START=true

# --------------------------------------------------------------------
# Blockfrost (used by POST /api/configs for trustless on-chain validation
# of the config UTxO + datum).
# --------------------------------------------------------------------
# Project ID from https://blockfrost.io — preprod project.
BLOCKFROST_PROJECT_ID=
# URL is auto-derived from APP_NETWORK if left empty. Override only if you're
# behind a proxy or using a self-hosted blockfrost-platform.
BLOCKFROST_URL=

# --------------------------------------------------------------------
# Admin-private profile (off for the public BE; on for the operator's
# rebalancer instance).
# --------------------------------------------------------------------
# Bech32 mnemonic phrase or hex private key. NEVER commit a real seed.
ADMIN_SEED=

# --------------------------------------------------------------------
# Server
# --------------------------------------------------------------------
SERVER_PORT=8080

# --------------------------------------------------------------------
# Curation gate
# --------------------------------------------------------------------
# Comma-separated lowercase-hex pkhs of operators whose submissions get
# auto-promoted into curated_collections (visible at GET /api/curated +
# the FE). Anything else is registered (indexer-tracked) but invisible
# publicly. Set to your wallet's payment pkh — derive via
# `./gradlew preprodDeriveAddress`.
OPERATOR_PKHS=

# --------------------------------------------------------------------
# Marketplace indexer
# --------------------------------------------------------------------
# Payment-key hash (56 lowercase hex chars = 28 bytes) of the wallet
# that owns the marketplace jars. Drives MarketplaceScriptAddressDeriver,
# which UPLC-applies it through the jar + marketplace bytecode to derive
# the singleton script address watched by MarketplaceEventsIndexer.
#
# Today the marketplace admin shares its pkh with the pit/p2p admin
# (the same wallet creates jars and config NFTs), so this is typically
# the same value as OPERATOR_PKHS above. They're separate properties so
# we can rotate either independently later.
#
# Leave empty to disable marketplace indexing — boot still succeeds,
# but /api/market/listings/by-pkh/{pkh} returns [] for every wallet.
# The WatchAddressRegistry logs `marketplace indexing disabled` at
# startup when unset.
SHITHOLE_MARKET_ADMIN_PKH=
