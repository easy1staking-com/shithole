# Shithole BE — mainnet environment template.
#
# Copy to api/.env.mainnet and populate. Source it before `./gradlew bootRun`:
#
#   set -a; source api/.env.mainnet; set +a; cd api && ./gradlew bootRun
#
# Mainnet defaults are deliberately conservative; you MUST set the empty values
# explicitly. .gitignore excludes the populated file.

# --------------------------------------------------------------------
# Database — production deployment likely uses a managed Postgres.
# --------------------------------------------------------------------
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --------------------------------------------------------------------
# Network selectors
# --------------------------------------------------------------------
APP_NETWORK=mainnet
NETWORK=mainnet
# Mainnet protocol magic.
PROTOCOL_MAGIC=764824073

# --------------------------------------------------------------------
# Yaci Store chain-sync
# --------------------------------------------------------------------
# Cardano node host:port. For mainnet you almost certainly want a dedicated
# node (a public Demeter or your own).
REMOTE_NODE_URL=
REMOTE_NODE_PORT=3001

# Operator-set starting slot. For a fresh mainnet deployment, pick the slot
# at which you intend to deploy the first config NFT. Without this, the
# indexer starts from genesis and takes days to catch up.
SHITHOLE_INDEXER_START_SLOT=

SHITHOLE_INDEXER_ENABLED=true
YACI_SYNC_AUTO_START=true

# --------------------------------------------------------------------
# Blockfrost — mainnet project ID.
# --------------------------------------------------------------------
BLOCKFROST_PROJECT_ID=
BLOCKFROST_URL=

# --------------------------------------------------------------------
# Admin-private profile.
# --------------------------------------------------------------------
# Bech32 mnemonic phrase or hex private key. NEVER commit a real seed.
# Use a hardware wallet or a secrets store in production.
ADMIN_SEED=

# --------------------------------------------------------------------
# Server
# --------------------------------------------------------------------
SERVER_PORT=8080
