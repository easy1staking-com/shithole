            },
            {
              "title": "admin_pkh",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            }
          ]
        }
      ]
    },
    "shithole/types/ListingDatum": {
      "title": "ListingDatum",
      "description": "Per-NFT listing slot. The NFT inside the UTxO changes per swap; the\n `lister_pkh` is fixed at initial creation and never changes.\n\n `update_ref` is the double-satisfaction binding for the listing-recreation\n path. On initial pay-to-script creation it is `None` and never validated.\n On every swap, the new listing output must carry\n `Some(compute_output_tag(consumed.outRef))`. This forces each consumed\n listing input to demand a uniquely-bound successor output.",
      "anyOf": [
        {
          "title": "ListingDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
