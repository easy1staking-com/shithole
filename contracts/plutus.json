    "shithole/types/ConfigDatum": {
      "title": "ConfigDatum",
      "description": "Per-collection configuration.\n\n `collection_policy_id` is NOT a datum field — it lives as the config NFT's\n asset name (28 bytes, enforced at mint). Once minted it is immutable.\n\n `treasury_addr` should always be a base/payment-key address in practice\n (wallet, possibly HW). Script credentials are technically allowed but the\n script must accept payments with our tagged inline datum and not require\n any other signatures or datum fields — see SPEC §3.1 note.",
      "anyOf": [
        {
          "title": "ConfigDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "m",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "protocol_fee",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "lister_fee",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "treasury_addr",
              "$ref": "#/definitions/cardano~1address~1Address"
            },
            {
              "title": "admin_pkh",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            }
          ]
        }
      ]
    },
    "shithole/types/ListingRedeemer": {
      "title": "ListingRedeemer",
      "description": "Swap carries `nb_asset_name` (the NFT the swapper is depositing) and two\n output-index hints for O(1) lookup. NA's asset_name is read from the\n consumed listing's input value — not provided in the redeemer.\n\n The seed for the bucket equation is anchored to `own_ref` (the consumed\n listing's outRef), not to a swapper-controlled input. This makes the swap\n outcome a deterministic function of (consumed listing, deposited NFT)\n pairs — the swapper has no per-attempt manipulation axis. For dead\n collections this is the desired property.\n\n Recover is an admin-only rescue path for UTxOs that landed at the listing\n address with NO datum (e.g. someone pay-to-script'd by accident). Datum\n is required to be `None` — admin has no power over any datum-bearing UTxO.\n Validator pulls `admin_pkh` from the per-collection config (read as ref\n input, same lookup pattern as Swap).",
      "anyOf": [
        {
          "title": "Swap",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "nb_asset_name",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "listing_output_index",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "treasury_output_index",
              "$ref": "#/definitions/Option<Int>"
            }
          ]
        },
        {
          "title": "Cancel",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        },
        {
          "title": "Recover",
          "dataType": "constructor",
          "index": 2,
          "fields": []
        }
      ]
    },
    "shithole/types/WantedRedeemer": {
      "title": "WantedRedeemer",
      "description": "Redeemer for the wanted-listing validator.\n\n `Fulfill` is the happy path: seller deposits a trait-matching NFT and\n receives the offered NFT + bounty.\n\n `Reclaim` lets the buyer pull their offered NFT + bounty back out of\n the listing. Authorized by `signed_by(buyer_pkh)`.",
      "anyOf": [
        {
          "title": "Fulfill",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "merkle_proof",
              "description": "Merkle proof of the deposited NFT's `asset_name` (28 bytes) against\n `WantedDatum.accepted_merkle_root`. List of 32-byte sibling hashes\n from leaf to root. The verifier uses sorted-pair concatenation so\n the proof needs no direction bits.",
              "$ref": "#/definitions/List<ByteArray>"
            },
            {
              "title": "treasury_output_index",
              "description": "Some(idx) ⇒ outputs[idx] is the treasury payment, validated against\n cfg.protocol_fee + the compute_output_tag(own_ref) anti-double-sat\n tag. None ⇒ no treasury output supplied; validator requires\n `cfg.protocol_fee == 0`.",
              "$ref": "#/definitions/Option<Int>"
            }
          ]
        },
        {
          "title": "Reclaim",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        }
      ]
    }
