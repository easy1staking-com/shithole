# Shithole web — mainnet DEVELOPMENT environment template.
#
# Use this when developing the babel-fee feature locally against mainnet
# (no FluidTokens tanks exist on preview/preprod — the only place to
# develop + test the FT integration is real mainnet).
#
# Copy to .env.mainnet-dev and populate. Run with:
#   cd web && npx next dev --env-file .env.mainnet-dev
#
# .gitignore excludes the populated file.
#
# !!! READ ME !!!
# This wires the local FE to the production BE (api.shithole.app) and
# mainnet Blockfrost. ANY tx you sign with a mainnet wallet here costs
# REAL ADA / HOSKY / USDM. Use a low-balance test wallet for dev.

NEXT_PUBLIC_API_MODE=live

# Production API URL — same as prod Vercel deploy.
NEXT_PUBLIC_API_BASE_URL=https://api.shithole.app

NEXT_PUBLIC_CARDANO_NETWORK=mainnet

# Mainnet Blockfrost project ID.
# Get from https://blockfrost.io → create a project → select Mainnet.
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=

# Marketplace UI on — same as prod.
NEXT_PUBLIC_FEATURE_MARKETPLACE=on

# Babel-fee feature flag — keep behind its own gate during build-out so
# the toggle only surfaces when explicitly enabled. Empty / "off" hides
# the "enable babel fee" checkbox on the buy page.
NEXT_PUBLIC_FEATURE_BABEL_FEE=on
