# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Network-specific template files ARE tracked; the populated `.env.preprod`
# / `.env.mainnet` are not (matched by the `.env*` glob above).
!.env.preprod.example
!.env.mainnet.example
!.env.mainnet-dev.example
!.env.preview.example
!.env.devnet.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
