# Shithole web — preprod environment template.
#
# Copy to .env.preprod (Next reads .env.local by default in dev; for explicit
# environment selection use `next dev --env-file .env.preprod` or symlink
# .env.local → .env.preprod).
#
# .gitignore excludes the populated file.

# Switch off MSW and hit the real BE.
NEXT_PUBLIC_API_MODE=live

# Local BE during dev; for staging, point at the deployed URL.
# Origin only — the client paths already include the /api/ prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Preprod network — affects address derivation, Blockfrost URL, and the
# wallet-network mismatch check on the admin form.
NEXT_PUBLIC_CARDANO_NETWORK=preprod

# Preprod Blockfrost project ID.
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=
