# Shithole web — mainnet environment template.
#
# Copy to .env.mainnet (Next reads .env.local by default in dev; for explicit
# environment selection use `next dev --env-file .env.mainnet`).
#
# .gitignore excludes the populated file.

NEXT_PUBLIC_API_MODE=live

# Production API URL.
NEXT_PUBLIC_API_BASE_URL=https://api.shithole.example

NEXT_PUBLIC_CARDANO_NETWORK=mainnet

# Mainnet Blockfrost project ID.
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=
