# Shithole web — environment variables
#
# Copy to .env.local to override defaults.

# API mode. Controls whether MSW intercepts /api/* fetches.
#   "mock" — start MSW with the committed fixtures (default in dev).
#   "live" — disable MSW; fetches hit the real BE at NEXT_PUBLIC_API_BASE_URL.
# When unset, dev mode defaults to "mock"; production defaults to "live".
NEXT_PUBLIC_API_MODE=mock

# Base URL for the BE. Empty string means same-origin (which is what MSW
# expects). For "live" mode, set to e.g. https://api.shithole.example.
NEXT_PUBLIC_API_BASE_URL=

# Cardano network: mainnet | preprod | preview. Default: preprod.
NEXT_PUBLIC_CARDANO_NETWORK=preprod

# Blockfrost project id matching the chosen network. Used as the Lucid
# Evolution provider when building the deploy-config tx on the admin page.
# Sign up at https://blockfrost.io. Empty = tx submission disabled but the
# wallet-connect path still works.
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=
